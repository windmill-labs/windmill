      { "value": "https://www.googleapis.com/auth/drive.readonly", "label": "Read all Drive files" },
      { "value": "https://www.googleapis.com/auth/drive", "label": "Read, edit, create and delete all Drive files" }
    ],
    "extra_params": {
      "access_type": "offline",
      "prompt": "consent"
    }
  },
