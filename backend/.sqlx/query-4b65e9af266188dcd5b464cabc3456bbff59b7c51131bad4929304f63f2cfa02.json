{
  "db_name": "PostgreSQL",
  "query": "SELECT t.label, t.token_prefix, t.expiration, t.created_at, t.last_used_at, t.scopes, t.workspace_id, t.read_only, t.allowed_ips::text[] AS allowed_ips, (t.admin AND EXISTS (SELECT 1 FROM usr u WHERE u.email = t.email AND u.is_admin AND NOT u.disabled AND (t.workspace_id IS NULL OR u.workspace_id = t.workspace_id))) AS \"admin!\", ((t.super_admin OR COALESCE(t.label = 'session', false)) AND COALESCE((SELECT p.super_admin FROM password p WHERE p.email = t.email), false)) AS \"super_admin!\" FROM token t WHERE t.email = $1\n             ORDER BY t.created_at DESC LIMIT $2 OFFSET $3",
