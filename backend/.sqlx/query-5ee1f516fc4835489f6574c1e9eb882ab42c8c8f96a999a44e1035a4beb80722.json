{
  "db_name": "PostgreSQL",
  "query": "SELECT id, trigger_kind, path, operation, source, username, created_at, changes\n         FROM trigger_history\n         WHERE workspace_id = $1\n           AND ($2::TEXT IS NULL OR trigger_kind = $2)\n           AND ($3::TEXT IS NULL OR path = $3)\n         ORDER BY id DESC\n         LIMIT $4 OFFSET $5",
