{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (path) path, language AS \"language: ScriptLang\", content,\n                job_token_scopes IS NOT NULL AS \"restricted!\",\n                EXISTS (SELECT 1 FROM script l WHERE l.workspace_id = s.workspace_id AND l.path = s.path\n                    AND l.archived = false AND l.lock IS NOT NULL AND l.lock_error_logs IS NULL) AS \"locked!\"\n             FROM script s\n             WHERE workspace_id = $1\n               AND path = ANY($2)\n               AND archived = false\n               AND dedicated_worker = true\n             ORDER BY path, created_at DESC",
