{
  "db_name": "PostgreSQL",
  "query": "SELECT c.channel_id, c.channel_name, c.agent_path, c.is_default, c.members_only\n         FROM slack_agent_channel c\n         JOIN resource r ON r.workspace_id = c.workspace_id AND r.path = c.agent_path\n         WHERE c.workspace_id = $1 ORDER BY c.channel_name, c.agent_path",
