  "query": "SELECT j.permissioned_as, v.extra_perms, v.created_by, v.generation\n         FROM v2_job j\n         JOIN v2_job_queue q ON q.id = j.id\n         JOIN volume v ON v.workspace_id = j.workspace_id AND v.name = $3\n         WHERE j.id = $1 AND j.workspace_id = $2 AND q.running AND q.worker = $4",
