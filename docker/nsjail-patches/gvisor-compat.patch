diff --git a/user.cc b/user.cc
index a335e2d..f3e578b 100644
--- a/user.cc
+++ b/user.cc
@@ -260,10 +260,24 @@ bool initNsFromChild(nsjconf_t* nsjconf) {
 	 * Make sure all capabilities are retained after the subsequent setuid/setgid, as they will
 	 * be needed for privileged operations: mounts, uts change etc.
 	 */
+	bool securebits_set = true;
 	if (prctl(PR_SET_SECUREBITS, SECBIT_KEEP_CAPS | SECBIT_NO_SETUID_FIXUP, 0UL, 0UL, 0UL) ==
 	    -1) {
-		PLOG_E("prctl(PR_SET_SECUREBITS, SECBIT_KEEP_CAPS | SECBIT_NO_SETUID_FIXUP)");
-		return false;
+		/*
+		 * The bits only matter when setresuid() below changes the UID: without them,
+		 * leaving UID 0 clears the capabilities still needed by the jail setup.
+		 */
+		uid_t ruid, euid, suid;
+		const uid_t uid = nsjconf->uids[0].inside_id;
+		if (!nsjconf->gvisor_compat || errno != EPERM ||
+		    getresuid(&ruid, &euid, &suid) == -1 || ruid != uid || euid != uid ||
+		    suid != uid) {
+			PLOG_E("prctl(PR_SET_SECUREBITS, SECBIT_KEEP_CAPS | SECBIT_NO_SETUID_FIXUP)");
+			return false;
+		}
+		PLOG_W("prctl(PR_SET_SECUREBITS, SECBIT_KEEP_CAPS | SECBIT_NO_SETUID_FIXUP), "
+		       "ignored (gvisor_compat, UID unchanged)");
+		securebits_set = false;
 	}
 
