{
  "user": {
    "username": "admin",
    "is_admin": true
  },
  "workspace": {
    "flows": [
      {
        "path": "f/billing/charge_customers",
        "summary": "Charge customers with due invoices",
        "description": "Every night, charges each customer whose invoice is due and emails a receipt.",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "dry_run": { "type": "boolean", "default": false }
          },
          "required": []
        },
        "value": {
          "modules": [
            {
              "id": "fetch_due",
              "summary": "Fetch invoices due today from the warehouse",
              "value": {
                "type": "rawscript",
                "language": "postgresql",
                "content": "-- database f/data/warehouse\nSELECT id, customer_id, amount_cents FROM invoices WHERE due_date = current_date AND paid = false;",
                "input_transforms": {
                  "database": { "type": "static", "value": "$res:f/data/warehouse" }
                }
              }
            },
            {
              "id": "charge",
              "summary": "Charge each invoice",
              "value": {
                "type": "forloopflow",
                "iterator": { "type": "javascript", "expr": "results.fetch_due" },
                "skip_failures": false,
                "modules": [
                  {
                    "id": "charge_one",
                    "summary": "Charge one invoice through the payment API",
                    "value": {
                      "type": "rawscript",
                      "language": "bun",
                      "content": "export async function main(invoice: { id: number; amount_cents: number }) {\n  const res = await fetch('https://payments.example.com/charge', { method: 'POST', body: JSON.stringify(invoice) })\n  if (!res.ok) throw new Error(`charge failed for invoice ${invoice.id}`)\n  return await res.json()\n}\n",
                      "input_transforms": {
                        "invoice": { "type": "javascript", "expr": "flow_input.iter.value" }
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "email_receipts",
              "summary": "Email a receipt to each charged customer",
              "value": {
                "type": "rawscript",
                "language": "bun",
                "content": "export async function main(charges: unknown[]) {\n  return { sent: charges.length }\n}\n",
                "input_transforms": {
                  "charges": { "type": "javascript", "expr": "results.charge" }
                }
              }
            }
          ]
        }
      }
    ],
    "scripts": [
      {
        "path": "f/ops/check_ssl_expiry",
        "summary": "Check SSL certificate expiry",
        "language": "bun",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "domain": { "type": "string", "description": "The domain whose certificate to check" }
          },
          "required": ["domain"]
        },
        "content": "export async function main(domain: string) {\n  const res = await fetch(`https://ssl-check.example.com/${domain}`)\n  return await res.json()\n}\n"
      }
    ],
    "resources": [
      {
        "path": "f/data/warehouse",
        "resource_type": "postgresql",
        "description": "Production warehouse",
        "value": {
          "host": "db.internal",
          "port": 5432,
          "dbname": "warehouse",
          "user": "windmill",
          "password": "$var:f/data/warehouse_password"
        },
        "dbSchema": {
          "public": {
            "customers": {
              "id": { "type": "integer", "required": true },
              "email": { "type": "text", "required": true },
              "plan": { "type": "text", "required": false },
              "created_at": { "type": "timestamp", "required": true, "default": "now()" }
            },
            "invoices": {
              "id": { "type": "integer", "required": true },
              "customer_id": { "type": "integer", "required": true },
              "amount_cents": { "type": "integer", "required": true },
              "due_date": { "type": "date", "required": true },
              "paid": { "type": "boolean", "required": true, "default": "false" }
            },
            "signups": {
              "id": { "type": "integer", "required": true },
              "email": { "type": "text", "required": true },
              "source": { "type": "text", "required": false },
              "created_at": { "type": "timestamp", "required": true, "default": "now()" }
            }
          }
        }
      },
      {
        "path": "f/team/slack",
        "resource_type": "slack",
        "description": "Team Slack bot",
        "value": { "token": "$var:f/team/slack_token" }
      }
    ]
  }
}
