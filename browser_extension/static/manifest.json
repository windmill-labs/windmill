{
	"manifest_version": 3,
	"name": "Windmill",
	"version": "0.1.0",
	"description": "Windmill AI sessions in the side panel, with tools that act on the active tab.",
	"permissions": ["sidePanel", "storage", "scripting", "tabs"],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Open Windmill",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		}
	},
	"side_panel": {
		"default_path": "panel.html"
	},
	"options_page": "options.html",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
